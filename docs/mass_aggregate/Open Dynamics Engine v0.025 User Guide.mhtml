void dJointGetHinge2Axis1 (dJointID, dVector3 result);
void dJointGetHinge2Axis2 (dJointID, dVector3 result);
</font></a></pre><blockquote><a name=3D"func_dJointGetHinge2Anchor">
Get hinge-2 anchor and axis parameters.
</a></blockquote><p></p><p><a name=3D"func_dJointGetHinge2Anchor">
</a><a name=3D"func_dJointGetHinge2Angle1"></a></p><pre><a name=3D"func_dJo=
